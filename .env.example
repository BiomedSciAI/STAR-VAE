# STAR-VAE environment template. Source this file with Bash or a compatible shell.
# Python commands do not automatically load it.

# Resolve the repository root from this file, not from the caller's directory.
if [[ -z "${STAR_VAE_ROOT:-}" ]]; then
  _STAR_VAE_ENV_SOURCE="${BASH_SOURCE[0]:-$0}"
  STAR_VAE_ROOT="$(cd "$(dirname "${_STAR_VAE_ENV_SOURCE}")" && pwd -P)"
  unset _STAR_VAE_ENV_SOURCE
fi
export STAR_VAE_ROOT

export CHECKPOINT_DIR="${CHECKPOINT_DIR:-${STAR_VAE_ROOT}/checkpoints}"
export DATA_DIR="${DATA_DIR:-${STAR_VAE_ROOT}/data}"
export OUTPUT_DIR="${OUTPUT_DIR:-${STAR_VAE_ROOT}/outputs}"

export VOCAB_FILE="${VOCAB_FILE:-${CHECKPOINT_DIR}/vae_pubchem80m/vocab.json}"
export SMILES_VOCAB_MOSES="${SMILES_VOCAB_MOSES:-${CHECKPOINT_DIR}/vae_moses/smiles_vocab_moses.json}"

# Names consumed by examples, configs, and checkpoint-aware tests.
export PRETRAINED_VAE_CKPT="${PRETRAINED_VAE_CKPT:-${CHECKPOINT_DIR}/vae_pubchem80m/last.ckpt}"
export PRETRAINED_VAE_MOSES_CKPT="${PRETRAINED_VAE_MOSES_CKPT:-${CHECKPOINT_DIR}/vae_moses/last.ckpt}"
export CKPT_SA_SCORE="${CKPT_SA_SCORE:-${CHECKPOINT_DIR}/cvae_sa_score/last.ckpt}"
export CKPT_1SYH="${CKPT_1SYH:-${CHECKPOINT_DIR}/cvae_1syh/last.ckpt}"
export CKPT_4LDE="${CKPT_4LDE:-${CHECKPOINT_DIR}/cvae_4lde/last.ckpt}"
export CKPT_6Y2F="${CKPT_6Y2F:-${CHECKPOINT_DIR}/cvae_6y2f/last.ckpt}"
export CKPT_1SYH_STRAT="${CKPT_1SYH_STRAT:-${CHECKPOINT_DIR}/cvae_1syh_stratified/last.ckpt}"
export CKPT_4LDE_STRAT="${CKPT_4LDE_STRAT:-${CHECKPOINT_DIR}/cvae_4lde_stratified/last.ckpt}"
export CKPT_6Y2F_STRAT="${CKPT_6Y2F_STRAT:-${CHECKPOINT_DIR}/cvae_6y2f_stratified/last.ckpt}"
export CKPT_B3DB="${CKPT_B3DB:-${CHECKPOINT_DIR}/cvae_b3db/last.ckpt}"
export CKPT_ABL_REF="${CKPT_ABL_REF:-${CHECKPOINT_DIR}/ablations/ref_selfies_pubchem/last.ckpt}"
export CKPT_ABL_A1_SELFIES="${CKPT_ABL_A1_SELFIES:-${CHECKPOINT_DIR}/ablations/a1_selfies_tokenization_supp/last.ckpt}"
export CKPT_ABL_A2="${CKPT_ABL_A2:-${CHECKPOINT_DIR}/ablations/a2_deterministic_ae/last.ckpt}"
export CKPT_ABL_A3_NONE="${CKPT_ABL_A3_NONE:-${CHECKPOINT_DIR}/ablations/a3_no_conditioning/last.ckpt}"
export CKPT_ABL_A3_ENC="${CKPT_ABL_A3_ENC:-${CHECKPOINT_DIR}/ablations/a3_encoder_conditioning/last.ckpt}"
export CKPT_ABL_A3_DEC="${CKPT_ABL_A3_DEC:-${CHECKPOINT_DIR}/ablations/a3_decoder_conditioning/last.ckpt}"
export CKPT_ABL_A4_FROZEN="${CKPT_ABL_A4_FROZEN:-${CHECKPOINT_DIR}/ablations/a4_frozen_backbone/last.ckpt}"
export CKPT_ABL_A4_FULL="${CKPT_ABL_A4_FULL:-${CHECKPOINT_DIR}/ablations/a4_full_finetune/last.ckpt}"
export CKPT_ABL_A5_LINEAR="${CKPT_ABL_A5_LINEAR:-${CHECKPOINT_DIR}/ablations/a5_linear_annealing/last.ckpt}"
export CKPT_ABL_A5_FIXED="${CKPT_ABL_A5_FIXED:-${CHECKPOINT_DIR}/ablations/a5_fixed_beta/last.ckpt}"

# Dataset files are available from their respective providers, review their terms, prepare the required columns, and update these paths.
export MOSES_RAW_CSV="${MOSES_RAW_CSV:-${DATA_DIR}/moses_raw/dataset_v1.csv}"
export MOSES_PROCESSED_DIR="${MOSES_PROCESSED_DIR:-${DATA_DIR}/moses_processed}"
export TARTARUS_DATA="${TARTARUS_DATA:-${DATA_DIR}/tartarus/docking_processed.csv}"
export B3DB_DATA="${B3DB_DATA:-${DATA_DIR}/b3db/b3db_regression_processed_filtered.csv}"
export CHEMBL_SPLIT_DIR="${CHEMBL_SPLIT_DIR:-${DATA_DIR}/chembl/silver_label_100k_cluster_split}"
export GUACAMOL_DATA_DIR="${GUACAMOL_DATA_DIR:-${DATA_DIR}/guacamol}"
export PUBCHEM_10K_SA="${PUBCHEM_10K_SA:-${DATA_DIR}/pubchem/data_pubchem_random_10k_selfies.csv}"
export SA_SCORE_TRAIN_CSV="${SA_SCORE_TRAIN_CSV:-${DATA_DIR}/pubchem/sa_score_minmax_train.csv}"
export SA_SCORE_VAL_CSV="${SA_SCORE_VAL_CSV:-${DATA_DIR}/pubchem/sa_score_minmax_val.csv}"
export TARTARUS_1SYH_TRAIN_CSV="${TARTARUS_1SYH_TRAIN_CSV:-${DATA_DIR}/tartarus/stratified/1syh_stratified_6k_train.csv}"
export TARTARUS_1SYH_VAL_CSV="${TARTARUS_1SYH_VAL_CSV:-${DATA_DIR}/tartarus/stratified/1syh_stratified_6k_val.csv}"
export TARTARUS_4LDE_TRAIN_CSV="${TARTARUS_4LDE_TRAIN_CSV:-${DATA_DIR}/tartarus/stratified/4lde_stratified_6k_train.csv}"
export TARTARUS_4LDE_VAL_CSV="${TARTARUS_4LDE_VAL_CSV:-${DATA_DIR}/tartarus/stratified/4lde_stratified_6k_val.csv}"
export TARTARUS_6Y2F_TRAIN_CSV="${TARTARUS_6Y2F_TRAIN_CSV:-${DATA_DIR}/tartarus/stratified/6y2f_stratified_6k_train.csv}"
export TARTARUS_6Y2F_VAL_CSV="${TARTARUS_6Y2F_VAL_CSV:-${DATA_DIR}/tartarus/stratified/6y2f_stratified_6k_val.csv}"

# External Tartarus checkout and optional environment prefix containing QVina and Open Babel executables. These are not included or installed by STAR-VAE.
export TARTARUS_ROOT="${TARTARUS_ROOT:-${DATA_DIR}/tartarus-toolkit}"
# export TARTARUS_ENV="/path/to/tartarus/environment"

export NUM_GPUS="${NUM_GPUS:-1}"
export DEFAULT_SEED="${DEFAULT_SEED:-101}"

# Optional experiment tracking. ClearML is not installed by this project.
export CLEARML_ENABLE="${CLEARML_ENABLE:-False}"
